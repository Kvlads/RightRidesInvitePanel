// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  Int           @id @default(autoincrement())
  vkId                BigInt        @unique
  name                String
  isBotMessagingAllow Boolean       @default(false)
  registrations       Participant[]
}

model Event {
  id              Int           @id @default(autoincrement())
  title           String
  location        String
  description     String?       @db.Text
  date            DateTime
  regEndDate      DateTime
  allowGuests     Boolean       @default(true)
  requireApproval Boolean       @default(false)
  image           String?
  isActive        Boolean       @default(true)
  registerOpen        Boolean       @default(true)
  isDeleted       Boolean       @default(false)
  participants    Participant[]
  createdAt       DateTime      @default(now())
  approvalText  String?         @db.Text
  rejectionText String?         @db.Text
}

model Participant {
  id          Int      @id @default(autoincrement())
  eventId     Int
  userId      Int?
  // Поля формы регистрации
  email       String?
  city        String?
  fio         String?
  plate       String?
  brand       String?
  passengers  String?
  comment     String?  @db.Text
  type        String   @default("participant") // "participant" или "guest"
  
  status      String   @default("pending") // "pending", "approved", "rejected"
  photos      Photo[]
  createdAt   DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User?  @relation(fields: [userId], references: [id], onDelete: Cascade)

  vkAttachments String?  @db.Text // Хранит строку "photo123_456,photo123_457"
  votes         Vote[]
}

model Photo {
  id            Int         @id @default(autoincrement())
  url           String
  participantId Int
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
}

// Новая модель для учета голосов
model Vote {
  id            Int         @id @default(autoincrement())
  participantId Int
  vkId          BigInt
  name          String
  decision      String      // "yes" или "no"
  createdAt     DateTime    @default(now())

  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  // Один администратор может проголосовать за одну заявку только 1 раз
  @@unique([participantId, vkId]) 
}