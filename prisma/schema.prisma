// prisma/schema.prisma

generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Строка url удалена, Prisma теперь берет её из prisma.config.ts
}

model User {
  id        Int      @id
  firstName String
  lastName  String
  createdAt DateTime @default(now())
}

model Event {
  id                 Int      @id @default(autoincrement())
  name               String
  eventDate          String   // Храним в формате ДД.ММ.ГГ
  regEndDate         String   // Храним в формате ДД.ММ.ГГ
  photoId            String?  // ID фотографии ВКонтакте (например, photo123_456)
  maxGuests          Int      @default(0)
  maxParticipants    Int      @default(0)
  isGuestRegRequired Boolean
  isApprovalRequired Boolean
  deleted            Boolean  @default(false) // Флаг мягкого удаления
  createdAt          DateTime @default(now())
}